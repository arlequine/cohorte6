# Llave de la API de Anthropic: https://console.anthropic.com/settings/keys
# Fija un límite de gasto en la consola antes de desplegar.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo (opcional). Los valores vigentes están en versions.md del repo del programa.
# ANTHROPIC_MODEL=claude-haiku-5-5

# Token que protegerá el endpoint de tu agente en producción (Estación 3).
# Genera uno con: openssl rand -hex 24
# AGENT_ACCESS_TOKEN=

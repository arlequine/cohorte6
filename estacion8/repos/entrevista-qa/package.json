{
  "name": "entrevista-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "verify": "npm run lint && npm run typecheck && npm test",
    "hooks": "git config core.hooksPath .githooks && echo 'Hooks de git activados'",
    "sync-skills": "bash scripts/sync-skills.sh",
    "test:e2e": "playwright test --project=e2e",
    "test:bdd": "bddgen && playwright test --project=bdd",
    "test:api": "playwright test --project=api",
    "test:playwright": "bddgen && playwright test",
    "evals": "tsx evals/evaluar.ts",
    "evals:calibrar": "tsx evals/calibrar.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "playwright-bdd": "^9.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}

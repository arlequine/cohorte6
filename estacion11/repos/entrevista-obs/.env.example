# Llave de la API de Anthropic: https://console.anthropic.com/settings/keys
# Fija un límite de gasto en la consola antes de desplegar.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo (opcional). El valor por defecto está en lib/agent.ts y en versions.md del repo del programa.
# ANTHROPIC_MODEL=claude-haiku-5-5

# Token que protege /api/agent en producción (recomendado en Vercel).
# Genera uno con: openssl rand -hex 24
# AGENT_ACCESS_TOKEN=

# Motor del agente: "reglas" fuerza el motor determinista (sin costo). Sin ANTHROPIC_API_KEY también se usa.
# AGENT_MODE=reglas

# Evaluación (evals/): la app a evaluar y los modelos de la Persona y el Juez (opcionales).
# AGENT_URL=http://localhost:3000
# PERSONA_MODEL=claude-haiku-5-5
# JUDGE_MODEL=claude-sonnet-5-5

# --- Estación 11: observabilidad ---
# Motor simulado: el motor de Claude con un cliente falso. Misma instrumentación, sin llave ni costo.
# AGENT_MODE=simulado
# SIMULADO_LATENCIA_MS=800
# SIMULADO_TASA_ERROR=0.05

# OpenTelemetry. Sin OTEL_EXPORTER_OTLP_ENDPOINT la app no carga el SDK y no manda telemetría.
# Con el otel-stack de la Estación 11 corriendo en tu máquina:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=entrevista-ai
# OTEL_METRIC_EXPORT_INTERVAL=5000
# Para un backend en la nube (Grafana Cloud, Honeycomb, etc.), su endpoint OTLP y su encabezado de autenticación:
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic ...

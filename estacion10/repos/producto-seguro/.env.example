# Llave de la API de Anthropic: https://console.anthropic.com/settings/keys
# Fija un límite de gasto en la consola antes de desplegar.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo (opcional). El valor por defecto está en lib/agent.ts y en versions.md del repo del programa.
# ANTHROPIC_MODEL=claude-haiku-5-5

# Token que protege /api/agent en producción (recomendado en Vercel).
# Genera uno con: openssl rand -hex 24
# AGENT_ACCESS_TOKEN=

# Historial en DynamoDB (Estación 9). Sin DYNAMODB_TABLE, el historial queda apagado.
# En producción, Terraform define estas variables en Vercel.
# DYNAMODB_TABLE=producto-local-conversaciones
# APP_AWS_REGION=us-east-1
# En local con LocalStack:
# APP_AWS_ENDPOINT=http://localhost:4566
# APP_AWS_ACCESS_KEY_ID=test
# APP_AWS_SECRET_ACCESS_KEY=test
